<?xml version="1.0"?>
<sdf version="1.11">
  <model name="dock">
    <pose>0 0 0.05 0 0 0</pose> <!-- rests on the ground -->
    <static>true</static>

    <link name="base_link">
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.2</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.2</iyy><iyz>0.0</iyz>
          <izz>0.2</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.6 0.6 0.1</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box><size>0.6 0.6 0.1</size></box>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
