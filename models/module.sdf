<?xml version="1.0"?>
<sdf version="1.11">
  <model name="module">
    <pose>0 0 0.2 0 0 0</pose> <!-- drops down into dock height -->
    <static>false</static>

    <link name="base_link">
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.1</ixx><ixy>0.0</ixy><ixz>0.0</ixx>
          <iyy>0.1</iyy><iyz>0.0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.3 0.3 0.2</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box><size>0.3 0.3 0.2</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.6 0.9 1</ambient>
          <diffuse>0.1 0.6 0.9 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
